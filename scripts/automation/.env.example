# Browser automation configuration. Copy to .env and fill in real values.
# .env is gitignored — never commit real values.

# --- Account identity (used by all scripts) ---
# The Microsoft account that signs up / logs in for AI-club Azure.
AICLUB_MS_ACCOUNT=aiclub2026@outlook.com

# --- Signup form fields (playwright-signup.ts) ---
# Profile fields auto-filled before the human break-points.
PROFILE_COUNTRY=Japan
PROFILE_FIRST_NAME=
PROFILE_LAST_NAME=
PROFILE_FIRST_NAME_FURIGANA=
PROFILE_LAST_NAME_FURIGANA=
PROFILE_EMAIL=
PROFILE_PHONE_E164=+81...
# Address: must match credit card billing address.
PROFILE_POSTAL_CODE=
PROFILE_PREFECTURE=
PROFILE_CITY=
PROFILE_ADDRESS_LINE1=
PROFILE_ADDRESS_LINE2=
PROFILE_COMPANY_OPTIONAL=

# --- Browser behavior ---
# Set HEADED=1 (default) to watch the browser. HEADED=0 for CI / unattended.
HEADED=1
# How long to pause for a human action (ms). 0 = wait for keypress.
HUMAN_PAUSE_MS=0
# Screenshot on every break-point (debug aid).
SCREENSHOT_ON_PAUSE=1

# --- Output ---
# Where captured TENANT_ID + SUB_ID get written after signup.
ENV_OUTPUT_PATH=../../.env.azure
