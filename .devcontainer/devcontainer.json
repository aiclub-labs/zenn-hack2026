{
  "name": "msft-agent-hackathon-2026",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": { "installZsh": false, "upgradePackages": false },
    "ghcr.io/azure/azure-dev/azd:latest": {}
  },
  "postCreateCommand": "pip install -e '.[dev]' && az bicep install && sudo apt-get update && sudo apt-get install -y jq && curl -fsSL https://bun.sh/install | bash",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-bicep",
        "ms-azuretools.vscode-azurecontainerapps"
      ]
    }
  }
}
